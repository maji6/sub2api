# =============================================================================
# Bundle stack: bridge-enabled sub2api + sub2api-audit + postgres + redis
# =============================================================================
# Replace image names with the published images you control.
# Important:
#   - SUB2API_IMAGE must be a bridge-enabled build from your fork's
#     prompt-audit branch (or an equivalent patched branch).
#   - Official upstream sub2api images will not emit prompt audit events
#     until the bridge is merged upstream.
# =============================================================================

# Published images
SUB2API_IMAGE=ghcr.io/your-org/sub2api-prompt-audit:latest
SUB2API_AUDIT_IMAGE=ghcr.io/your-org/sub2api-audit:latest

# Bind addresses / ports
BIND_HOST=0.0.0.0
SUB2API_PORT=8080
AUDIT_PORT=8087

# Shared timezone
TZ=Asia/Shanghai

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_USER=sub2api
POSTGRES_PASSWORD=change_this_secure_password
POSTGRES_DB=sub2api

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_PASSWORD=
REDIS_DB=0

# -----------------------------------------------------------------------------
# sub2api bootstrap
# -----------------------------------------------------------------------------
ADMIN_EMAIL=admin@sub2api.local
ADMIN_PASSWORD=
JWT_SECRET=
TOTP_ENCRYPTION_KEY=
SERVER_MODE=release
RUN_MODE=standard

# Prompt audit bridge config in sub2api
GATEWAY_PROMPT_AUDIT_ENABLED=true
GATEWAY_PROMPT_AUDIT_STREAM_NAME=prompt_audit:sampled
GATEWAY_PROMPT_AUDIT_SAMPLE_RATE_BASIS_POINTS=200
GATEWAY_PROMPT_AUDIT_MAX_BODY_BYTES=131072

# -----------------------------------------------------------------------------
# sidecar consumer / API
# -----------------------------------------------------------------------------
SUB2API_AUDIT_AUDIT_CONSUMER_ENABLED=true
SUB2API_AUDIT_AUDIT_STREAM_NAME=prompt_audit:sampled
SUB2API_AUDIT_AUDIT_CONSUMER_GROUP=prompt-audit-sidecar
SUB2API_AUDIT_AUDIT_CONSUMER_NAME=sub2api-audit-1
SUB2API_AUDIT_AUDIT_BATCH_SIZE=16
SUB2API_AUDIT_AUDIT_BLOCK_SECONDS=5
SUB2API_AUDIT_AUDIT_INSERT_TIMEOUT_SECONDS=5
SUB2API_AUDIT_AUDIT_DEFAULT_LIST_LIMIT=50
SUB2API_AUDIT_AUDIT_MAX_LIST_LIMIT=200

# Optional:
# Leave empty to let sidecar read settings.admin_api_key from shared PostgreSQL.
SUB2API_AUDIT_ADMIN_AUTH_ADMIN_API_KEY=
