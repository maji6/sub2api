# -----------------------------------------------------------------------------
# sub2api-audit standalone docker-compose example
# -----------------------------------------------------------------------------

# Bind host / port
BIND_HOST=0.0.0.0
AUDIT_PORT=8087

# PostgreSQL DSN
# If you want sidecar to automatically reuse the same admin api key as sub2api,
# point this DSN to the SAME PostgreSQL database used by sub2api.
SUB2API_AUDIT_DATABASE_DSN=postgres://postgres:postgres@127.0.0.1:5432/sub2api?sslmode=disable

# Redis
SUB2API_AUDIT_REDIS_ADDR=127.0.0.1:6379
SUB2API_AUDIT_REDIS_PASSWORD=
SUB2API_AUDIT_REDIS_DB=0

# Stream consumer
SUB2API_AUDIT_AUDIT_STREAM_NAME=prompt_audit:sampled
SUB2API_AUDIT_AUDIT_CONSUMER_GROUP=prompt-audit-sidecar
SUB2API_AUDIT_AUDIT_CONSUMER_NAME=sub2api-audit-1

# Optional:
# Set this only when sidecar does NOT share the same PostgreSQL settings table
# with sub2api. When empty, sidecar reads settings.admin_api_key from database.
SUB2API_AUDIT_ADMIN_AUTH_ADMIN_API_KEY=

# Timezone
TZ=Asia/Shanghai
